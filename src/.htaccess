# Soly'bat — configuration Apache (Hostinger/OVH)

# --- HTTPS + domaine canonique (www) ---
# Les deux regles menent a https://www.solybat18.fr, qui est la forme declaree
# par site.json, les <link rel="canonical">, le sitemap et robots.txt.
#
# La premiere regle traite d'un coup le domaine nu ET l'absence de HTTPS :
# elle reecrit vers l'hote canonique en dur, sans reutiliser %{HTTP_HOST}.
# Passer par deux redirections enchainees (http->https puis nu->www) ferait
# perdre a Google une partie du signal de lien a chaque saut.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domaine nu (avec ou sans HTTPS) -> www en HTTPS, en un seul saut.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.solybat18.fr%{REQUEST_URI} [L,R=301]

  # Deja en www mais en clair -> HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Page d'erreur 404 personnalisée ---
ErrorDocument 404 /404.html

# --- Compression (Gzip/Brotli si disponible) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache navigateur ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # En-têtes de sécurité de base
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Type MIME du manifest ---
<Files "manifest.json">
  ForceType application/manifest+json
</Files>
