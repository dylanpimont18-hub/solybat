---
layout: layouts/base.njk
pagination:
  data: realisations
  size: 1
  alias: projet
permalink: "/realisations/{{ projet.slug }}/"
eleventyComputed:
  titre: "{{ projet.titre | replace(' — ', ', ') | safe }}"
  description: "{{ projet.resume | safe }}"
---
{% from "composants/placeholder-photo.njk" import placeholderPhoto %}
{% from "composants/slider-avant-apres.njk" import sliderAvantApres %}
<section class="conteneur">
  <p><a href="{{ '/realisations/' | url }}">← Retour aux réalisations</a></p>
  <h1>{{ projet.titre }}</h1>

  {% if projet.photos.avant and projet.photos.apres %}
  {{ sliderAvantApres(projet.photos.avant, projet.photos.apres, projet.titre, prioritaire=true) }}
  {% elif projet.photos.apres %}
  <div class="projet__photo-seule">
    {% set dimSeule = ('/images/realisations/' + projet.photos.apres) | dimensionsImage %}
    <img src="{{ ('/images/realisations/' + projet.photos.apres) | url }}" alt="{{ projet.titre }} — après travaux" {% if dimSeule %}width="{{ dimSeule.largeur }}" height="{{ dimSeule.hauteur }}"{% endif %} fetchpriority="high" decoding="async">
  </div>
  {% else %}
  {{ placeholderPhoto() }}
  {% endif %}

  <dl class="projet__meta">
    <div><dt>Surface</dt><dd>{{ projet.surface }}</dd></div>
    <div><dt>Durée</dt><dd>{{ projet.duree }}</dd></div>
    <div><dt>Corps de métier</dt><dd>{{ projet.corpsDeMetier | join(", ") }}</dd></div>
  </dl>

  <p>{{ projet.resume }}</p>
</section>
